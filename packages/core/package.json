{
  "name": "@altersend/core",
  "version": "1.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker-client": {
      "types": "./dist/client/worker-client.d.ts",
      "default": "./dist/client/worker-client.js"
    }
  },
  "private": true,
  "license": "Apache-2.0",
  "author": "AlterSend",
  "repository": {
    "type": "git",
    "url": "https://github.com/denislupookov/altersend.git"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "b4a": "1.8.1",
    "bare-buffer": "3.6.1",
    "bare-crypto": "1.15.0",
    "bare-dns": "2.1.4",
    "bare-fs": "4.7.2",
    "bare-process": "4.4.1",
    "bare-rpc": "1.3.2",
    "bare-tcp": "2.5.0",
    "bare-tls": "3.1.7",
    "bare-zlib": "1.4.0",
    "compact-encoding": "2.19.2",
    "corestore": "7.10.0",
    "hypercore-crypto": "3.7.0",
    "hyperdrive": "13.3.2",
    "hyperswarm": "4.17.0",
    "localdrive": "2.2.1",
    "mirror-drive": "1.14.2",
    "protomux": "3.11.0"
  },
  "devDependencies": {
    "@types/b4a": "1.6.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
