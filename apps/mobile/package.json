{
  "private": true,
  "name": "@altersend/mobile",
  "version": "1.1.5",
  "description": "AlterSend mobile app (React Native / Expo)",
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "pnpm run bundle-bare",
    "start": "expo start --dev-client",
    "postinstall": "pnpm run barekit:link-ios-addons && pnpm run barekit:link-android-addons",
    "eas-build-post-install": "cd ../.. && pnpm --filter @altersend/core build && pnpm --filter @altersend/domain build && pnpm --filter @altersend/components build && pnpm --filter @altersend/mobile bundle-bare",
    "barekit:link-ios-addons": "node ./scripts/link-ios-addons.cjs",
    "barekit:link-android-addons": "node ./scripts/link-android-addons.cjs",
    "pods:install": "cd ios && LANG=en_US.UTF-8 pod install",
    "preandroid": "pnpm run bundle:android",
    "android": "expo run:android",
    "preios": "pnpm run bundle:ios",
    "ios": "expo run:ios",
    "bundle:android": "bare-pack --host android-arm64 --host android-arm --host android-ia32 --host android-x64 --linked --out bundles/app-android.bundle.js ../../packages/core/dist/worklet/index.js",
    "bundle:ios": "bare-pack --host ios-arm64 --host ios-arm64-simulator --host ios-x64-simulator --linked --out bundles/app-ios.bundle.js ../../packages/core/dist/worklet/index.js",
    "bundle-bare": "pnpm run bundle:android && pnpm run bundle:ios",
    "typecheck": "tsc --noEmit",
    "build:apk": "eas build --platform android --profile preview",
    "build:apk:local": "pnpm --filter @altersend/core build && pnpm exec expo prebuild --clean --platform android --non-interactive && pnpm run bundle:android && cd android && gradlew.bat assembleRelease"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/denislupookov/altersend.git"
  },
  "author": "AlterSend",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/denislupookov/altersend/issues"
  },
  "homepage": "https://github.com/denislupookov/altersend#readme",
  "dependencies": {
    "@altersend/components": "workspace:1.1.5",
    "@altersend/core": "workspace:1.1.5",
    "@altersend/domain": "workspace:1.1.5",
    "@expo/vector-icons": "15.1.1",
    "@sentry/react-native": "8.13.0",
    "b4a": "1.8.1",
    "expo": "55.0.26",
    "expo-blur": "55.0.14",
    "expo-build-properties": "55.0.14",
    "expo-camera": "55.0.19",
    "expo-clipboard": "55.0.13",
    "expo-constants": "55.0.16",
    "expo-document-picker": "55.0.13",
    "expo-file-system": "55.0.22",
    "expo-haptics": "15.0.8",
    "expo-image-picker": "55.0.20",
    "expo-linking": "55.0.15",
    "expo-media-library": "55.0.17",
    "expo-router": "55.0.16",
    "expo-share-intent": "6.1.1",
    "expo-sharing": "55.0.20",
    "expo-system-ui": "55.0.18",
    "lucide-react-native": "1.17.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-b4a": "0.0.4",
    "react-native-bare-kit": "0.14.2",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-svg": "15.15.3",
    "react-strict-dom": "0.0.55"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/react": "19.2.16",
    "bare-pack": "2.0.1",
    "react-native-svg-transformer": "1.5.3",
    "typescript": "5.9.3",
    "bare-link": "3.2.2"
  }
}
