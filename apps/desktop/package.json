{
  "name": "@altersend/desktop",
  "productName": "AlterSend",
  "version": "1.1.3",
  "upgrade": "pear://w5u4xqsncqyfhb1owdqogr3mpg6b5tcdzn65pk88ispgew5jegso",
  "description": "Peer-to-peer file transfer. No servers, no accounts.",
  "license": "Apache-2.0",
  "author": "AlterSend",
  "type": "module",
  "main": "dist/electron/main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/gen-sentry-dsn.cjs && tsc -p src/tsconfig.electron.json && node scripts/copy-preload.cjs && vite build",
    "build:electron": "node scripts/gen-sentry-dsn.cjs && tsc -p src/tsconfig.electron.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit -p src/tsconfig.electron.json && tsc --noEmit -p tsconfig.json",
    "start": "pnpm run build && electron-forge start -- --no-updates",
    "start:peer2": "pnpm run build && electron-forge start -- --no-updates --multi --storage=../../storage-2",
    "start:peer3": "pnpm run build && electron-forge start -- --no-updates --multi --storage=../../storage-3",
    "dist:prepare:dev": "pnpm install && pnpm run build && pnpm prune --prod && pnpm add -w electron@40.10.2 --save-prod --config.save=false",
    "dist:mac:arm64": "pnpm exec electron-builder --mac --arm64 -c electron-builder.mac.json --publish never",
    "dist:mac:x64": "pnpm exec electron-builder --mac --x64 -c electron-builder.mac.json --publish never",
    "dist:mac:arm64:dev": "SKIP_NOTARIZE=true CSC_IDENTITY_AUTO_DISCOVERY=false pnpm run dist:mac:arm64",
    "dist:mac:x64:dev": "SKIP_NOTARIZE=true CSC_IDENTITY_AUTO_DISCOVERY=false pnpm run dist:mac:x64",
    "dist:win:x64": "electron-forge make --platform=win32 --arch=x64",
    "dist:win:arm64": "electron-forge make --platform=win32 --arch=arm64",
    "dist:linux:x64": "pnpm exec electron-builder --linux --x64 -c electron-builder.linux.json --publish never",
    "dist:linux:arm64": "pnpm exec electron-builder --linux --arm64 -c electron-builder.linux.json --publish never",
    "pear:build:darwin:arm64": "pnpm exec pear-build --package=./package.json --darwin-arm64-app ./out/mac-arm64/AlterSend.app --target ../../../altersend-desktop-$npm_package_version",
    "pear:build:darwin:x64": "pnpm exec pear-build --package=./package.json --darwin-x64-app ./out/mac/AlterSend.app --target ../../../altersend-desktop-$npm_package_version",
    "pear:build:linux:x64": "pnpm exec pear-build --package=./package.json --linux-x64-app ./out/AlterSend-x64.AppImage --target ../../../altersend-desktop-$npm_package_version",
    "pear:build:linux:arm64": "pnpm exec pear-build --package=./package.json --linux-arm64-app ./out/AlterSend-arm64.AppImage --target ../../../altersend-desktop-$npm_package_version",
    "pear:build:win:x64": "pnpm exec pear-build --package=./package.json --win32-x64-app ./out/AlterSend-win32-x64/AlterSend.msix --target ..\\..\\.\\altersend-desktop-%npm_package_version%",
    "dist:win:builder:x64": "node scripts/build-win-builder.cjs"
  },
  "dependencies": {
    "@altersend/components": "workspace:1.1.3",
    "@altersend/core": "workspace:1.1.3",
    "@altersend/domain": "workspace:1.1.3",
    "@sentry/electron": "7.13.0",
    "b4a": "1.8.1",
    "bare-rpc": "1.3.2",
    "corestore": "7.10.0",
    "electron-squirrel-startup": "1.0.1",
    "hypercore-crypto": "3.7.0",
    "hyperdrive": "13.3.2",
    "hyperswarm": "4.17.0",
    "lucide-react": "1.17.0",
    "paparam": "1.10.1",
    "pear-runtime": "1.1.4",
    "pear-runtime-updater": "3.1.0",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "which-runtime": "1.4.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-msix": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron/notarize": "2.5.0",
    "@babel/core": "7.29.7",
    "@stylexjs/babel-plugin": "0.15.4",
    "@tailwindcss/vite": "4.3.0",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "25.9.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "app-builder-lib": "26.8.1",
    "electron": "40.10.2",
    "electron-builder": "26.8.1",
    "pear-build": "1.1.0",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vite-plugin-babel": "1.7.3"
  }
}
