{
  "name": "@altersend/cli",
  "version": "1.2.0",
  "description": "CLI for AlterSend P2P file transfer",
  "type": "module",
  "bin": {
    "altersend": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@altersend/core": "1.2.0",
    "@altersend/domain": "1.2.0",
    "b4a": "^1.8.0",
    "paparam": "^1.10.0",
    "pear-runtime": "^1.1.1",
    "qrcode": "^1.5.4",
    "which-runtime": "^1.3.2"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}