{
  "name": "altersend",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run desktop:dev",
    "build:libs": "npm run build -w packages/drive && npm run build -w packages/core && npm run build -w packages/locales && npm run build -w packages/domain && npm run build -w packages/components",
    "mobile": "npm run build:libs && npm run ios -w apps/mobile",
    "mobile:setup": "npm run build:libs && npm run setup:ios -w apps/mobile",
    "mobile:start": "npm start -w apps/mobile",
    "desktop:dev": "npm run build:libs && npm start -w apps/desktop",
    "desktop:dev:peer2": "npm run build:libs && npm run start:peer2 -w apps/desktop",
    "desktop:build": "npm run build:libs && npm run build -w apps/desktop",
    "components:build": "npm run build -w packages/components",
    "domain:build": "npm run build -w packages/domain",
    "locales:build": "npm run build -w packages/locales",
    "locales:typecheck": "npm run typecheck -w packages/locales",
    "components:typecheck": "npm run typecheck -w packages/components",
    "components:storybook": "npm run storybook -w packages/components",
    "components:build-storybook": "npm run build-storybook -w packages/components",
    "build": "npm run build:libs && npm run build --if-present -w apps/desktop",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint apps packages --max-warnings=0",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" \"packages/**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" \"*.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" \"packages/**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" \"*.md\" \"docs/**/*.md\"",
    "check:tokens": "bash scripts/check-tokens.sh",
    "knip": "knip",
    "version:bump": "node scripts/bump-version.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "{apps,packages}/**/*.{ts,tsx,js,jsx}": "eslint --no-warn-ignored --max-warnings=0"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "xcode": {
      "uuid": "^11.1.1"
    },
    "@electron/node-gyp": "npm:node-gyp@^10"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "knip": "^6.14.1",
    "lint-staged": "^16.4.0",
    "prettier": "~3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  },
  "version": "1.8.0",
  "dependencies": {
    "expo": "~56.0.18",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3"
  }
}
